# Copy to .env and fill in real values. Never commit a real .env.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/clintondetail_db
POSTGRES_PASSWORD=
# Twilio (required for real SMS; leave blank and the API reports sms_sent: false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Extra TrustedHost entries (comma-separated), e.g. the host platform's own
# domain before the custom domain is pointed at the service:
EXTRA_ALLOWED_HOSTS=
# Meta Lead Ads (Phase 1)
META_VERIFY_TOKEN=
